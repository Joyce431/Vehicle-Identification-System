<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<BorderPane fx:id="borderpane" prefHeight="800" prefWidth="1200" style="-fx-background-color: gray;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="joyce.vehicleidentificationsystem1.DashboardController">

    <top>
        <MenuBar fx:id="menubar">
            <Menu text="File">
                <MenuItem onAction="#handleExit" text="Exit" />
                <SeparatorMenuItem />
                <MenuItem onAction="#Logout" text="Logout" />
            </Menu>
            <Menu text="Modules">
                <MenuItem onAction="#loadAdminView" text="Admin" />
                <MenuItem onAction="#loadCustomerView" text="Customer" />
                <MenuItem onAction="#loadPoliceView" text="Police" />
                <MenuItem onAction="#loadWorkshopView" text="Workshop" />
                <MenuItem onAction="#loadInsuranceView" text="Insurance" />
            </Menu>
            <Menu text="Help">
                <MenuItem onAction="#showAbout" text="About" />
            </Menu>
        </MenuBar>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab fx:id="dashboard" closable="false" text="Dashboard">
                <!-- MAIN SCROLLPANE - Makes entire dashboard scrollable -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox fx:id="vbox" alignment="TOP_CENTER" spacing="15" style="-fx-padding: 20;">

                        <!-- Title -->
                        <Label fx:id="statistics" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="System Statistics" />

                        <!-- Statistics Cards -->
                        <HBox alignment="CENTER" spacing="50">
                            <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 10;">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #3498db;" text="Total Vehicles" />
                                <Label fx:id="vehicle" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3498db;" text="0" />
                            </VBox>
                            <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 10;">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2ecc71;" text="Total Customers" />
                                <Label fx:id="registration" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;" text="0" />
                            </VBox>
                            <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 10;">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;" text="Violations" />
                                <Label fx:id="violations" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" text="0" />
                            </VBox>
                            <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 10;">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #f39c12;" text="Services Completed" />
                                <Label fx:id="complete" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f39c12;" text="0" />
                            </VBox>
                        </HBox>

                        <!-- Progress Indicators -->
                        <HBox alignment="CENTER" spacing="50">
                            <VBox alignment="CENTER" spacing="5">
                                <Label style="-fx-font-weight: bold;" text="Vehicle Registration Progress" />
                                <ProgressIndicator fx:id="vehicleProgress" prefHeight="60" prefWidth="60" progress="0.65" />
                                <Label text="65% Complete" />
                            </VBox>
                            <VBox alignment="CENTER" spacing="5">
                                <Label style="-fx-font-weight: bold;" text="System Capacity" />
                                <ProgressBar fx:id="systemCapacity" prefWidth="250" progress="0.45" />
                                <Label fx:id="used" text="45% Used" />
                            </VBox>
                        </HBox>

                        <!-- Recent Activities ScrollPane -->
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 10 0 5 0;" text="Recent Activities" />
                        <ScrollPane fx:id="activityScroll" fitToWidth="true" prefHeight="150" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
                            <VBox fx:id="activityList" spacing="5" style="-fx-padding: 10;" />
                        </ScrollPane>

                        <!-- Student & Course Directory (20+ entries) -->
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 15 0 5 0;" text="Student &amp; Course Directory (20 entries)" />
                        <ScrollPane fx:id="dummyScrollPane" fitToWidth="true" prefHeight="250" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
                            <VBox fx:id="dummyContentBox" spacing="8" style="-fx-padding: 10;" />
                        </ScrollPane>

                        <!-- Vehicle Records with Pagination -->
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 10 0 5 0;" text="Vehicle Records" />
                        <Pagination fx:id="vehiclePagination" maxPageIndicatorCount="5" pageCount="10">
                     <effect>
                        <DropShadow height="32.72" radius="18.060000000000002" width="41.52">
                           <color>
                              <Color red="0.8026315569877625" green="0.14491958916187286" blue="0.14491958916187286" />
                           </color>
                        </DropShadow>
                     </effect></Pagination>

                        <!-- Recent Violations Table -->
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 10 0 5 0;" text="Recent Violations" />
                        <TableView fx:id="violationTable" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="violationTypeCol" prefWidth="200" text="Violation Type">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="type" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="fineAmountCol" prefWidth="150" text="Fine Amount">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="fineAmount" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="statusCol" prefWidth="150" text="Status">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="status" />
                                    </cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>

                        <!-- Buttons with Visual Effects -->
                        <HBox alignment="CENTER" spacing="30" style="-fx-padding: 15 0 10 0;">
                            <Button fx:id="shadowButton" onAction="#reportV" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 5;" text="Report Violation">
                                <effect>
                                    <DropShadow height="25.66" offsetX="3.0" offsetY="3.0" radius="12.33" width="25.66">
                              <color>
                                 <Color red="0.05263157933950424" green="0.05141325667500496" blue="0.05141325667500496" />
                              </color></DropShadow>
                                </effect>
                            </Button>
                            <Button fx:id="fadeButton" onAction="#refreshV" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 5;" text="Refresh Data">
                        <effect>
                           <DropShadow height="26.86" radius="12.93" width="26.86" />
                        </effect></Button>
                        </HBox>

                    </VBox>
                </ScrollPane>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #34495e; -fx-padding: 8 15;">
            <Label fx:id="statusLabel" text="System Ready" textFill="white" />
            <Label text="|" textFill="#7f8c8d" />
            <Label text="Connected to Database: PostgreSQL" textFill="#2ecc71" />
            <Label text="|" textFill="#7f8c8d" />
            <Label fx:id="timeLabel" text="" textFill="white" />
        </HBox>
    </bottom>
</BorderPane>
