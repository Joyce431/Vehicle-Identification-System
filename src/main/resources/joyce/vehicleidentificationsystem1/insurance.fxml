<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="joyce.vehicleidentificationsystem1.InsuranceController">

    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <!-- TITLE -->
    <Label text="Insurance Module"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Separator/>

    <!-- ADD INSURANCE -->
    <TitledPane text="Add Insurance" expanded="true">
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="10" bottom="10" left="10" right="10"/>
            </padding>

            <Label text="Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="vehicleCombo" prefWidth="200"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Company:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="companyField"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Policy No:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="policyField"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Expiry Date:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <DatePicker fx:id="expiryDate"
                        GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label fx:id="validation" text="" textFill="red"
                   GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2"/>

            <Button text="Add Insurance"
                    onAction="#addInsurance"
                    style="-fx-background-color: green; -fx-text-fill: white;"
                    GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2">
                <effect>
                    <DropShadow/>
                </effect>
            </Button>
        </GridPane>
    </TitledPane>

    <!-- STATUS -->
    <Label text="Insurance Status" style="-fx-font-weight: bold;"/>

    <HBox spacing="20" alignment="CENTER">
        <VBox alignment="CENTER">
            <Label text="Validity"/>
            <ProgressBar fx:id="insuranceProgress" progress="0.6" prefWidth="150"/>
        </VBox>

        <VBox alignment="CENTER">
            <Label text="Overall Coverage"/>
            <ProgressIndicator fx:id="coverageIndicator" progress="0.75"/>
        </VBox>

        <VBox alignment="CENTER">
            <Label text="Active Policies"/>
            <Label fx:id="instatus" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: green;"/>
        </VBox>

        <VBox alignment="CENTER">
            <Label text="Expiring Soon"/>
            <Label fx:id="insurance" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: orange;"/>
        </VBox>

        <VBox alignment="CENTER">
            <Label text="Total Records"/>
            <Label fx:id="inrecords" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: blue;"/>
        </VBox>

        <VBox alignment="CENTER">
            <Label text="Overall Rating"/>
            <Label fx:id="overall" text="0%" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: purple;"/>
        </VBox>
    </HBox>

    <!-- TABLE -->
    <Label text="Insurance Records" style="-fx-font-weight: bold;"/>

    <TableView fx:id="insuranceTable" prefHeight="200">
        <columns>
            <TableColumn fx:id="tcol1" text="Policy Number" prefWidth="150"/>
            <TableColumn fx:id="tcol2" text="Vehicle Number" prefWidth="120"/>
            <TableColumn fx:id="tcol3" text="Company" prefWidth="150"/>
            <TableColumn fx:id="tcol4" text="Expiry Date" prefWidth="120"/>
        </columns>
    </TableView>

    <!-- PAGINATION -->
    <Pagination fx:id="insurancePagination" pageCount="5"/>

</VBox>