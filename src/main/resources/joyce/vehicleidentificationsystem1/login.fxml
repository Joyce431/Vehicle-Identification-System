<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<BorderPane fx:id="borderpane" style="-fx-background-color: linear-gradient(to bottom, #2c3e50, #3498db);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="joyce.vehicleidentificationsystem1.LoginController">

    <center>
        <VBox fx:id="vbox1" alignment="CENTER" spacing="20">
            <padding>
                <Insets bottom="50" left="50" right="50" top="50" />
            </padding>

            <!-- Title -->
            <VBox fx:id="vbox2" alignment="CENTER" spacing="10">
                <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="Vehicle Identification System" />
                <Label fx:id="label1" style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;" text="Please login to continue" />
            </VBox>

            <!-- Login Card -->
            <VBox fx:id="vbox3" alignment="CENTER" maxWidth="400" prefWidth="400" spacing="20" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30;">

                <effect>
                    <DropShadow offsetX="5.0" offsetY="5.0">
                  <color>
                     <Color red="0.07000000029802322" green="0.06406000256538391" blue="0.06369999796152115" opacity="0.30000001192092896" />
                  </color></DropShadow>
                </effect>

                <!-- User ID Field -->
                <VBox fx:id="vbox4" prefWidth="340" spacing="5">
                    <Label fx:id="userid" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="User ID" />
                    <TextField fx:id="userIdField" promptText="Enter your User ID" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;" />
                </VBox>

                <!-- Password Field -->
                <VBox fx:id="vbox5" prefWidth="340" spacing="5">
                    <Label fx:id="password" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Password" />
                    <PasswordField fx:id="passwordField" promptText="Enter your password" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;" />
                </VBox>

                <!-- Role Selection -->
                <VBox fx:id="role" prefWidth="340" spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Role" />
                    <ComboBox fx:id="roleCombo" prefWidth="340" promptText="Select your role" />
                </VBox>

                <!-- Login Button -->
                <Button fx:id="login" onAction="#login" prefHeight="40" prefWidth="340" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5;" text="LOGIN">
                    <effect>
                        <DropShadow height="107.73" offsetX="2.0" offsetY="2.0" radius="53.3625" width="107.72">
                     <color>
                        <Color red="0.07000000029802322" green="0.06948667019605637" blue="0.06930000334978104" opacity="0.5" />
                     </color></DropShadow>
                    </effect>
                </Button>

                <!-- Status Label -->
                <Label fx:id="statusLabel" style="-fx-text-fill: red; -fx-font-size: 12px;" text="" />

                <!-- Register Link -->
                <HBox alignment="CENTER" spacing="5">
                    <Label fx:id="label" style="-fx-text-fill: #7f8c8d;" text="Don't have an account?" />
                    <Label fx:id="register" onMouseClicked="#handleRegister" style="-fx-text-fill: #3498db; -fx-cursor: hand;" text="Register Here" />
                </HBox>
            </VBox>
         <effect>
            <DropShadow>
               <color>
                  <Color red="0.2631579041481018" green="0.22417153418064117" blue="0.22417153418064117" />
               </color>
            </DropShadow>
         </effect>
        </VBox>
    </center>
</BorderPane>
